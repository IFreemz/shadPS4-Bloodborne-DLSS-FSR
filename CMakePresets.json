{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "include": ["cmake/CMake${hostSystemName}Presets.json"],
  "configurePresets": [
    {
      "name": "x64-Clang-Debug",
      "displayName": "Clang x64 Debug",
      "inherits": ["x64-Clang-Base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-Clang-Release",
      "displayName": "Clang x64 Release",
      "inherits": ["x64-Clang-Base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-Clang-PGO-Training",
      "displayName": "Clang x64 Release, PGO training (instrumented, LTO)",
      "inherits": ["x64-Clang-Base"],
      "binaryDir": "${sourceDir}/Build/pgo-training-x64-Clang-Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "ON",
        "BB_PGO": "generate"
      }
    },
    {
      "name": "x64-Clang-Release-PGO",
      "displayName": "Clang x64 Release with LTO and the PGO profile (pgo/bb.profdata)",
      "inherits": ["x64-Clang-Base"],
      "binaryDir": "${sourceDir}/Build/pgo-x64-Clang-Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "ON",
        "BB_PGO": "${sourceDir}/pgo/bb.profdata"
      }
    },
    {
      "name": "x64-Clang-RelWithDebInfo",
      "displayName": "Clang x64 RelWithDebInfo",
      "inherits": ["x64-Clang-Base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ]
}
