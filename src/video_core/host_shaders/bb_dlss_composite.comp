#version 460
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0) uniform sampler2D upscaled;     // DLSS output of the pre-HUD scene
layout(binding=1) uniform sampler2D final_frame;  // game frame with HUD (render size)
layout(binding=2) uniform sampler2D scene_frame;  // pre-HUD snapshot (render size)
layout(binding=3) uniform sampler2DArray lut;     // game display LUT, layer = channel
#ifdef HDR_OUTPUT
layout(binding=4, rgba16f) uniform writeonly image2D result; // RenoDX: values above 1 kept
#else
layout(binding=4, rgba8) uniform writeonly image2D result;
#endif
layout(binding=5) uniform sampler2D motion;
layout(binding=6, std430) buffer Coverage {
    uint changed_pixels; // output pixels the HUD changed, read back to detect menus
};
// Histogram of the HUD's dimming t over lit pixels: count and sum of t * 256 per bin.
layout(binding=7, std430) buffer Dimming {
    uint dim_count[64];
    uint dim_sum[64];
};
// The HUD as its own layer (render size, bb_hud_layer.comp): rgb = HUD, a = scene shown.
layout(binding=8) uniform sampler2D hud_layer;
layout(push_constant) uniform Push {
    uint flags;      // 1: add HUD, 2: apply LUT, 4: motion debug view, 8: menu (game frame only),
                     // 16: upscaled is linear light (encode it to sRGB),
                     // 32: keep the game frame's alpha (RenoDX keeps HDR data there),
                     // 64: HUD-less copy for frame generation (scene alpha, not counted),
                     // 128: RenoDX HDR, upscaled holds reversibly tone-mapped linear light and
                     //      the scene and result may exceed 1,
                     // 512: the HUD from its own layer (hud_layer) over the upscaled scene
    float sharpness; // 0 off .. 1 strongest (robust contrast-adaptive sharpening)
} pc;

vec3 ToSrgb(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

// Reversible tone map (see bb_dlss_linearize.comp): sharpening works on these values. The cap
// (32x white) is far above RenoDX's scene and keeps upscaler overshoot near 1 from turning into
// extreme values when the tone map is undone.
const float ToneMappedMax = 0.97;

vec3 Upscaled(ivec2 p, ivec2 extent) {
    vec3 c = texelFetch(upscaled, clamp(p, ivec2(0), extent - 1), 0).rgb;
    if ((pc.flags & 128u) != 0)
        return clamp(c, 0, ToneMappedMax);
    c = clamp(c, 0, 1);
    return (pc.flags & 16u) != 0 ? ToSrgb(c) : c;
}

vec3 FromToneMapped(vec3 c) {
    return ToSrgb(c / (1.0 - max(c.r, max(c.g, c.b))));
}

shared uint group_changed;
shared uint group_count[64], group_sum[64];
shared float group_dimming;

// Writes one output pixel; returns whether the HUD changed it.
bool Shade(ivec2 pixel, ivec2 extent) {
    bool changed = false;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
    vec3 color = Upscaled(pixel, extent);
    if (pc.sharpness > 0) {
        // RCAS-style: negative lobe limited so the cross neighbourhood never clips.
        vec3 b = Upscaled(pixel + ivec2(0, -1), extent), d = Upscaled(pixel + ivec2(-1, 0), extent);
        vec3 f = Upscaled(pixel + ivec2(1, 0), extent), h = Upscaled(pixel + ivec2(0, 1), extent);
        vec3 lo = min(min(b, d), min(min(f, h), color));
        vec3 hi = max(max(b, d), max(max(f, h), color));
        vec3 hit_lo = lo / max(4.0 * hi, 1e-5);
        vec3 hit_hi = (1.0 - hi) / min(4.0 * lo - 4.0, -1e-5);
        vec3 lobe3 = max(-hit_lo, hit_hi);
        float lobe = max(-0.1875, min(max(lobe3.r, max(lobe3.g, lobe3.b)), 0.0)) * pc.sharpness;
        color = clamp((lobe * (b + d + f + h) + color) / (4.0 * lobe + 1.0), 0, 1);
    }
    if ((pc.flags & 128u) != 0)
        color = FromToneMapped(clamp(color, 0, ToneMappedMax));
    vec3 final_rgb = texture(final_frame, uv).rgb;
    vec3 scene_rgb = texture(scene_frame, uv).rgb;
    changed = any(greaterThan(abs(final_rgb - scene_rgb), vec3(4.0 / 255.0)));
    // The HUD as final = t * scene + overlay, with t the strongest uniform dimming of the scene
    // that keeps the overlay non-negative. Menus, fades and dialogs darken the whole scene;
    // applying that dimming to the upscaled image keeps the jittered render-size scene out of
    // the result. Where the HUD left the scene untouched, t = 1 and the overlay is zero.
    vec3 ratio = (final_rgb + 1.0 / 512.0) / (scene_rgb + 1.0 / 512.0);
    float t = clamp(min(ratio.r, min(ratio.g, ratio.b)), 0, 1);
    if ((pc.flags & 64u) != 0) {
        // HUD-less copy: the frame as shown without the HUD, with the dimming most of the frame
        // has (fades, dialog backdrops). Local dimming such as a prompt box stays HUD.
        color = group_dimming * ((pc.flags & 8u) != 0 ? scene_rgb : color);
    } else if ((pc.flags & 8u) != 0) {
        // A menu covers the screen: show the game's own frame.
        color = final_rgb;
    } else if ((pc.flags & 513u) == 513u && (pc.flags & 128u) == 0) {
        // The HUD over the upscaled scene, as see-through as measured: steady where something
        // detailed or moving is behind it.
        vec4 layer = texture(hud_layer, uv);
        color = clamp(layer.a * color + layer.rgb, 0, 1);
        // Where the HUD is white (clipped) in the game's frame, it stays white: over a bright
        // scene a clipped channel doesn't hold the HUD's part apart from the scene's.
        color = mix(color, final_rgb, step(vec3(0.98), final_rgb) * (1.0 - layer.a));
    } else if ((pc.flags & 1u) != 0) {
        color = t * color + max(final_rgb - t * scene_rgb, 0);
        if ((pc.flags & 128u) == 0)
            color = clamp(color, 0, 1);
    }
    if ((pc.flags & 64u) == 0 && max(scene_rgb.r, max(scene_rgb.g, scene_rgb.b)) > 0.06) {
        uint bin = min(uint(t * 63.0 + 0.5), 63u);
        atomicAdd(group_count[bin], 1u);
        atomicAdd(group_sum[bin], uint(t * 256.0 + 0.5));
    }
    if ((pc.flags & 4u) != 0) {
        vec2 mv = texture(motion, uv).rg;
        color = vec3(clamp(abs(mv) / 8, 0, 1), 0);
    }
    // The game's display copy maps r, g, b through LUT layers 0, 1, 2. Its shader writes them
    // swapped because the guest colour-buffer swap reorders them again; this image is plain RGBA.
    vec3 memory = (pc.flags & 2u) != 0
        ? vec3(texture(lut, vec3(color.r, 0, 0)).r, texture(lut, vec3(color.g, 0, 1)).r,
               texture(lut, vec3(color.b, 0, 2)).r)
        : color;
    float alpha = (pc.flags & 32u) == 0   ? 1.0
                  : (pc.flags & 64u) != 0 ? texture(scene_frame, uv).a
                                          : texture(final_frame, uv).a;
    imageStore(result, pixel, vec4(memory, alpha));
    return changed;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(result);
    uint local = gl_LocalInvocationIndex;
    group_count[local] = 0;
    group_sum[local] = 0;
    if (local == 0) {
        group_changed = 0;
        if ((pc.flags & 64u) != 0) {
            // The most common dimming the main pass counted.
            uint best = 0, best_bin = 63;
            for (uint i = 0; i < 64; ++i) {
                if (dim_count[i] > best) {
                    best = dim_count[i];
                    best_bin = i;
                }
            }
            group_dimming = best == 0 ? 1.0 : float(dim_sum[best_bin]) / (256.0 * float(best));
        }
    }
    barrier();
    if (all(lessThan(pixel, extent)) && Shade(pixel, extent) && (pc.flags & 64u) == 0)
        atomicAdd(group_changed, 1u);
    barrier();
    if (local == 0 && group_changed != 0)
        atomicAdd(changed_pixels, group_changed);
    if (group_count[local] != 0) {
        atomicAdd(dim_count[local], group_count[local]);
        atomicAdd(dim_sum[local], group_sum[local]);
    }
}
