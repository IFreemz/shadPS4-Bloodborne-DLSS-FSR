#version 460
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0) uniform sampler2D motion;           // upscaler motion, render pixels
layout(binding=1) uniform sampler2D character_motion; // skinned draws: rg vector, b valid
layout(binding=2, rgba16f) uniform writeonly image2D result;
layout(push_constant) uniform Push {
    uint character; // character_motion holds this frame's vectors
} pc;

// dlss.ini debug_motion=1 when the upscaler output replaces the game's own upscale: red and
// green are the horizontal and vertical motion (8 render pixels = full), blue marks pixels a
// skinned draw wrote a vector for.
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(result);
    if (any(greaterThanEqual(pixel, extent)))
        return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
    vec2 mv = texture(motion, uv).rg;
    float skinned = pc.character != 0 && texture(character_motion, uv).b > 0.99 ? 0.6 : 0.0;
    imageStore(result, pixel, vec4(clamp(abs(mv) / 8, 0, 1), skinned, 1));
}
